@model ShopMVC.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Cart";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-12">
            <h2 class="text-primary">Your cart</h2>
            <hr/>
        </div>
    </div>

    @if (Model.IsEmpty)
    {
        <p class="text-muted">Your cart is empty.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Continue shopping</a>
    }
    else
    {
        <table class="table table-bordered table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Product</th>
                <th scope="col" class="text-end">Unit price</th>
                <th scope="col" class="text-center">Quantity</th>
                <th scope="col" class="text-end">Line total</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <a asp-controller="Product" asp-action="GetWithDetailsById" asp-route-productId="@item.ProductId">@item.Name</a>
                    </td>
                    <td class="text-end">@item.UnitPrice.ToString("0.00") PLN</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@item.LineTotal.ToString("0.00") PLN</td>
                    <td class="text-end">
                        <form asp-action="RemoveProduct" asp-route-productId="@item.ProductId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Remove @item.Name">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
            <tr>
                <th colspan="3" scope="row">Total (@Model.TotalQuantity items)</th>
                <th class="text-end">@Model.TotalPrice.ToString("0.00") PLN</th>
                <th></th>
            </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-between">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Continue shopping</a>
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary">Checkout</a>
        </div>
    }
</div>
