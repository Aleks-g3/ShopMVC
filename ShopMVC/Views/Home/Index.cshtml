@model ShopMVC.ViewModels.SimpleProductViewModel[]

@{
    ViewData["Title"] = "Products";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-12">
            <h2 class="text-primary">Products</h2>
            <hr/>
        </div>
    </div>

    @if (Model.Length == 0)
    {
        <p class="text-muted">No products available yet.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top product-card-image" alt="@product.Name"
                                 loading="lazy" referrerpolicy="no-referrer">
                        }
                        else
                        {
                            <div class="product-card-image bg-light d-flex align-items-center justify-content-center text-secondary" role="img" aria-label="No product image">
                                <i class="bi bi-image fs-1" aria-hidden="true"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h3 class="card-title h5">@product.Name</h3>
                            <p class="card-text fw-bold">@product.Price.ToString("0.00") PLN</p>
                            <a class="btn btn-primary mt-auto align-self-start"
                               asp-controller="Product" asp-action="GetWithDetailsById" asp-route-productId="@product.Id">
                                View product
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
