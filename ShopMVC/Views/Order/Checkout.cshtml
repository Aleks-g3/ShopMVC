@using ShopMVC.Models.Shared
@model ShopMVC.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-12">
            <h2 class="text-primary">Checkout</h2>
            <hr/>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-7 order-2 order-md-1">
            <form asp-action="Checkout" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <h4>Shipment</h4>
                <div class="mb-3">
                    <label asp-for="Form.City" class="form-label"></label>
                    <input asp-for="Form.City" class="form-control" aria-describedby="city-error"/>
                    <span asp-validation-for="Form.City" class="text-danger" id="city-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.StreetName" class="form-label"></label>
                    <input asp-for="Form.StreetName" class="form-control" aria-describedby="street-error"/>
                    <span asp-validation-for="Form.StreetName" class="text-danger" id="street-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.StreetNumber" class="form-label"></label>
                    <input asp-for="Form.StreetNumber" class="form-control" type="number" min="1" placeholder="12" aria-describedby="street-number-error"/>
                    <span asp-validation-for="Form.StreetNumber" class="text-danger" id="street-number-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.ReceiverFullName" class="form-label"></label>
                    <input asp-for="Form.ReceiverFullName" class="form-control" aria-describedby="receiver-error"/>
                    <span asp-validation-for="Form.ReceiverFullName" class="text-danger" id="receiver-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.ShipmentMethod" class="form-label"></label>
                    <select asp-for="Form.ShipmentMethod" class="form-select">
                        <option value="@((int)ShipmentMethod.InPost)" data-cost="10">InPost (10.00 PLN)</option>
                        <option value="@((int)ShipmentMethod.Courier)" data-cost="20">Courier (20.00 PLN)</option>
                    </select>
                    <span asp-validation-for="Form.ShipmentMethod" class="text-danger"></span>
                </div>

                <h4>Payment</h4>
                <div class="mb-3">
                    <label asp-for="Form.PaymentMethod" class="form-label"></label>
                    <select asp-for="Form.PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                    <span asp-validation-for="Form.PaymentMethod" class="text-danger"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Place order</button>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-secondary">Back to cart</a>
                </div>
            </form>
        </div>

        <div class="col-12 col-md-5 order-1 order-md-2 mb-4 mb-md-0">
            <h4>Order summary</h4>
            <div class="table-responsive">
                <table class="table table-sm">
                    <tbody>
                    @foreach (var item in Model.Cart.Items)
                    {
                        <tr>
                            <td>@item.Name × @item.Quantity</td>
                            <td class="text-end text-nowrap">@item.LineTotal.ToString("0.00") PLN</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr>
                        <th scope="row">Products</th>
                        <td class="text-end text-nowrap" id="products-total" data-total="@Model.Cart.TotalPrice.ToString("0.00")">@Model.Cart.TotalPrice.ToString("0.00") PLN</td>
                    </tr>
                    <tr>
                        <th scope="row">Shipping</th>
                        <td class="text-end text-nowrap" id="shipping-cost">10.00 PLN</td>
                    </tr>
                    <tr>
                        <th scope="row">Total</th>
                        <td class="text-end text-nowrap fw-bold" id="order-total">@((Model.Cart.TotalPrice + 10m).ToString("0.00")) PLN</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script type="text/javascript">
        const shipmentMethod = document.getElementById("Form_ShipmentMethod");
        const productsTotal = document.getElementById("products-total");
        const shippingCost = document.getElementById("shipping-cost");
        const orderTotal = document.getElementById("order-total");

        function updateTotals() {
            if (!shipmentMethod || !productsTotal || !shippingCost || !orderTotal)
                return;

            const cost = Number(shipmentMethod.selectedOptions[0]?.dataset.cost ?? 0);
            const products = Number(productsTotal.dataset.total);
            shippingCost.textContent = cost.toFixed(2) + " PLN";
            orderTotal.textContent = (products + cost).toFixed(2) + " PLN";
        }

        shipmentMethod?.addEventListener("change", updateTotals);
        updateTotals();
    </script>
}
