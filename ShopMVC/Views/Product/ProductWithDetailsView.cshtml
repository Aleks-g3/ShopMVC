@model ShopMVC.ViewModels.ProductWithDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container p-3">
    <div class="row pt-4 g-4">
        <div class="col-12 col-md-5">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded product-detail-image" alt="@Model.Name"
                     loading="lazy" referrerpolicy="no-referrer">
            }
            else
            {
                <div class="product-detail-placeholder bg-light rounded d-flex align-items-center justify-content-center text-secondary" role="img" aria-label="No product image">
                    <i class="bi bi-image fs-1" aria-hidden="true"></i>
                </div>
            }
        </div>

        <div class="col-12 col-md-7">
            <h2 class="text-primary">@Model.Name</h2>
            <hr/>

            <dl class="row mb-4">
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9 fw-semibold">@Model.Price.ToString("0.00") PLN</dd>
            </dl>

            @if (Model.AvailableQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="AddProduct" asp-route-productId="@Model.Id" class="mb-3">
                    <label for="amount" class="form-label">Quantity</label>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="input-group" style="max-width: 9rem;">
                            <button type="button" class="btn btn-outline-primary" onclick="minusClick()" id="minus-btn" aria-label="Decrease quantity">
                                <i class="bi bi-dash-lg" aria-hidden="true"></i>
                            </button>
                            <input type="number" class="form-control text-center" id="amount" asp-for="Quantity" min="1" max="@Model.AvailableQuantity" step="1" inputmode="numeric" aria-label="Quantity" aria-describedby="amount-status">
                            <button type="button" class="btn btn-outline-primary" onclick="plusClick()" id="plus-btn" aria-label="Increase quantity">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            </button>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-cart-plus me-1" aria-hidden="true"></i>Add to cart
                        </button>
                        <span id="amount-status" class="visually-hidden" aria-live="polite">@Model.Quantity</span>
                    </div>
                    <div class="form-text">@Model.AvailableQuantity pieces available</div>
                </form>
            }
            else
            {
                <p class="text-danger fw-semibold">Out of stock</p>
                <p class="form-text">0 pieces available</p>
            }

            <hr/>
            <h3 class="h5">Description</h3>
            <p>@Model.Description</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to products</a>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        const minusBtn = document.getElementById("minus-btn");
        const plusBtn = document.getElementById("plus-btn");
        const amountField = document.getElementById("amount");
        const amountStatus = document.getElementById("amount-status");
        const maxQuantity = @Model.AvailableQuantity;

        function updateButtons() {
            if (!amountField || !minusBtn || !plusBtn || !amountStatus)
                return;

            const currentValue = Number(amountField.value) || 0;
            minusBtn.disabled = currentValue <= 1;
            plusBtn.disabled = currentValue >= maxQuantity;
            amountStatus.textContent = String(currentValue);
        }

        function clampQuantity() {
            if (!amountField)
                return;

            let value = Number(amountField.value);
            if (!Number.isFinite(value))
                value = 1;

            value = Math.trunc(value);
            if (value < 1)
                value = 1;
            if (value > maxQuantity)
                value = maxQuantity;

            amountField.value = String(value);
            updateButtons();
        }

        function minusClick() {
            if (!amountField)
                return;

            const currentValue = Number(amountField.value) || 0;
            if (currentValue > 1)
                amountField.value = String(currentValue - 1);
            updateButtons();
        }

        function plusClick() {
            if (!amountField)
                return;

            const currentValue = Number(amountField.value) || 0;
            if (currentValue < maxQuantity)
                amountField.value = String(currentValue + 1);
            updateButtons();
        }

        amountField?.addEventListener("input", updateButtons);
        amountField?.addEventListener("change", clampQuantity);
        amountField?.addEventListener("blur", clampQuantity);
        amountField?.closest("form")?.addEventListener("submit", clampQuantity);
        updateButtons();
    </script>
}
