@using ShopMVC.Models.Shared
@model ShopMVC.ViewModels.CreateUpdateProductFormDTO

@{
	ViewData["Title"] = ViewBag.Action + " product";
}

<form asp-action="@ViewBag.Action" asp-route-productId="@ViewBag.ProductId">
	<div class="border p-3 mt-4">
		<div class="row pb-2">
			<h2 class="text-primary">@ViewData["Title"]</h2>
			<hr />
		</div>
		<div asp-validation-summary="All" class="text-danger"></div>
		<div class="mb-3">
			<label asp-for="Name" class="form-label"></label>
			<input asp-for="Name" class="form-control" aria-describedby="name-error"/>
			<span asp-validation-for="Name" class="text-danger" id="name-error"></span>
		</div>
		<div class="mb-3">
			<label asp-for="Description" class="form-label"></label>
			<textarea asp-for="Description" class="form-control" rows="4" aria-describedby="description-error"></textarea>
			<span asp-validation-for="Description" class="text-danger" id="description-error"></span>
		</div>
		<div class="mb-3">
			<label asp-for="ImageUrl" class="form-label"></label>
			<input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/product.jpg" aria-describedby="image-url-help image-url-error"/>
			<div class="form-text" id="image-url-help">Optional. Absolute http(s) URL or a relative path.</div>
			<span asp-validation-for="ImageUrl" class="text-danger" id="image-url-error"></span>
		</div>
		<div class="mb-3">
			<label asp-for="Category" class="form-label"></label>
			<select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Category>()" aria-describedby="category-error">
				<option value="">Please select</option>
			</select>
			<span asp-validation-for="Category" class="text-danger" id="category-error"></span>
		</div>
		<div class="mb-3">
			<label asp-for="Price" class="form-label">Price (PLN)</label>
			<input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" aria-describedby="price-error"/>
			<span asp-validation-for="Price" class="text-danger" id="price-error"></span>
		</div>
		<div class="mb-3">
			<label asp-for="AvailableQuantity" class="form-label"></label>
			<input asp-for="AvailableQuantity" class="form-control" type="number" min="0" placeholder="0" aria-describedby="available-quantity-error available-quantity-help"/>
			<div class="form-text" id="available-quantity-help">Units customers can order right now.</div>
			<span asp-validation-for="AvailableQuantity" class="text-danger" id="available-quantity-error"></span>
		</div>

		<input type="hidden" asp-for="RowVersion"/>

		<button type="submit" class="btn btn-primary">@(ViewBag.Action == "Create" ? "Create" : "Update")</button>
		<a asp-action="Manage" class="btn btn-secondary">Cancel</a>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial"/>
}
